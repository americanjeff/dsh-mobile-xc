{
  "name": "dsh-mobile-xc",
  "version": "0.6.8",
  "description": "DSH Web 移动端 UI 适配集大成插件：overlay 抽屉、安全区、canary 防升级失效；<=1023px 生效，桌面零影响。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "mobile",
    "ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client && node scripts/verify-lib.mjs --write",
    "build:host": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js",
    "build:client": "esbuild src/client/index.ts --bundle --platform=browser --format=iife --outfile=lib/client.js --external:react",
    "verify": "tsc --noEmit && node scripts/verify-lib.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT",
  "author": "xchannel1987",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xchannel1987/dsh-mobile-xc.git"
  },
  "bugs": {
    "url": "https://github.com/xchannel1987/dsh-mobile-xc/issues"
  },
  "homepage": "https://github.com/xchannel1987/dsh-mobile-xc#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7-rc.1"
  }
}
